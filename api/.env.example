# Server configuration
PORT=3002
MONGODB_URI=mongodb://localhost:27017/comexpay
JWT_SECRET=change_me

# AWS Textract configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=

# Internal services
DOWNLOADER_URL=http://127.0.0.1:7070
INTERNAL_DOWNLOAD_TOKEN=replace_with_internal_token
URL_VERIFICAR_CELULAR=https://app.comexpay.co/verificar

# Mail settings
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
EMAL_TO=recipient@example.com

# Gmail OAuth (if using OAuth2 authentication)
OAUTH_CLIENTID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token

# Security and notification settings
PBKDF2_SALT=change_this_generated_salt
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LABSMOBILE_USERNAME=
LABSMOBILE_PASSWORD=
LABSMOBILE_BASE_URL=https://api.labsmobile.com/get/send.php
PASSWORD_RESET_BASE_URL=https://app.comexpay.co/verificacion/recuperar.html
